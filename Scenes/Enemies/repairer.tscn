[sub_resource type="GDScript" id="GDScript_4vj60"]
resource_name = "RepairerNav"
script/source = "extends Navigator

# The body owns its own position now: this navigator only ever produces a velocity,
# which repairer_manager.gd hands to move_and_slide so walls can actually stop us.

func set_target_pos(value: Vector2) -> void:
	_target_current_pos = value

func get_nav_velocity() -> Vector2:
	return _velocity

func set_nav_velocity(value: Vector2) -> void:
	_velocity = value

func _process(delta: float) -> void:
	if ignore_target:
		manual_movement(delta)
		return
	slow_down_and_stop() # Arrived: bleed off speed, the body still applies it

func manual_movement(_delta: float) -> void:
	set_target_pos(_target_current_pos) # Refresh the steering toward the waypoint we were given
	_velocity += _steering
"

