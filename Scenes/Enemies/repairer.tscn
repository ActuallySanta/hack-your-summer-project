[sub_resource type="GDScript" id="GDScript_4vj60"]
resource_name = "RepairerNav"
script/source = "extends Navigator

func set_target_pos(value: Vector2) -> void:
	_target_current_pos = value

func manual_movement(delta: float) -> void:
	_target_current_pos = node_to_go_to.global_position
	if max_speed < 0.0:
		_nav_position = _target_current_pos
		return
	_velocity += _steering
	_nav_position += _velocity * delta
"

