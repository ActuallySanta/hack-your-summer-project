[sub_resource type="GDScript" id="GDScript_yprqx"]
resource_name = "MinesAnimator"
script/source = "extends AnimatedSprite2D

@export var flash_time_delta_seconds : float = 1.0
@export var banger : AudioStreamPlayer2D
@export var fade_time : float = 0.35

@onready var flash_light := $TextureProgressBar

var _timer : SmartTimer

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	_timer = SmartTimer.new(flash_time_delta_seconds, bling, randf() * flash_time_delta_seconds)

func _process(delta: float) -> void: 
	_timer.increment( delta)
	if flash_light.modulate.a > 0:
		flash_light.modulate.a -= delta / fade_time

func bling() -> void:
	play(\"idle\")
	banger.play()
	flash_light.modulate.a = 1
"

