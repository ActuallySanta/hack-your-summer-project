[sub_resource type="GDScript" id="GDScript_4vj60"]
resource_name = "limbo_exit_door"
script/source = "# Limbo exit door should never be opened / closed in the room it exists; it should only rely on reading save data
extends Node2D

@export var open_out : bool

@onready var collider := $Collider/CollisionShape2D
@onready var closed_image := $ClosedImage
@onready var open_image_out := $OpenImageExtrusion
@onready var open_image_in := $OpenImageInlet
@onready var open_image := $OpenImage

func _ready() -> void:
	if SaveManager.is_airlock_open():
		collider.set_deferred(\"disabled\", true)
		open_image.visible = true
		if open_out:
			open_image_out.visible = true
			return
		
		open_image_in.visible = true
		return
	
	closed_image.visible = true
"

