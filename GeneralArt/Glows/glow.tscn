[sub_resource type="GDScript" id="GDScript_ur7l7"]
resource_name = "Glow"
script/source = "@tool
extends TextureProgressBar

@export var color : Color:
	set( new_value ):
		self_modulate = new_value
		color = new_value
		
@export_range(0,100,0.1,\"or_greater\") var life_time : float = 0
@export_range(0,360,0.1,\"prefer_slider\") var angle : float = 0:
	set( new_value ):
		angle = new_value
		_set_rotation_degrees(angle, arclen)
@export_range(0,180,0.5,\"prefer_slider\") var arclen : float = 0:
	set( new_value ):
		arclen = new_value
		value = new_value / 180
		_set_rotation_degrees(angle, arclen)

var _time : float = 0.0

func _ready() -> void: 
	self_modulate = color
	if life_time == 0: process_mode = PROCESS_MODE_DISABLED
	
func _process(delta: float) -> void:
	if Engine.is_editor_hint(): return
	
	_time += delta
	if _time >= life_time:
		visible= false
		queue_free()
		return
		
	var percent_visible := 1 - _time / life_time
	self_modulate.a = percent_visible

func _set_rotation_degrees(forward_angle: float, arclength: float) -> void:
	forward_angle -= arclength
	rotation_degrees = forward_angle
"

