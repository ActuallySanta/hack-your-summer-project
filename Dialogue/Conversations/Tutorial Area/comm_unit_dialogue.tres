[sub_resource type="Resource" id="Resource_l55ao"]
script = ExtResource("1_tpatx")
entryText = "Aanyways. to get going, your first task is to try to get power back on, it should let you get through those unpowered doors, I'm sure you can figure it out"
speaker = ExtResource("3_on3xb")
metadata/_custom_type_script = "uid://bdh437kih1wx8"

[sub_resource type="Resource" id="Resource_6p5h7"]
script = ExtResource("1_tpatx")
entryText = "Ughhhh fine, I'll start looking around"
speakerEmotion = 4
speaker = ExtResource("2_gvu28")
metadata/_custom_type_script = "uid://bdh437kih1wx8"

[sub_resource type="Resource" id="Resource_e6tee"]
